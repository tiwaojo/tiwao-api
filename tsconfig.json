{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "lib": ["esnext"],
    "strict": true,
    "rootDir": ".",
    "outDir": "dist",
    "sourceMap": true,
    "esModuleInterop": true,
    "skipLibCheck": true // Skip type checking of all declaration files (*.d.ts). Should be false in a real project but resolves type errors in Prisma and lru-cache(Map) via apollo-server
    // "strictNullChecks": false,
  },
  "include": ["src/**/*.ts", "prisma/seed.ts",],
  "exclude": ["node_modules","src/test/*.test.ts"]
}